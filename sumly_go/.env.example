HTTP_ADDR=:18090
# 与 registration_system_go 共用同一个 PostgreSQL 实例和 database，
# 表全部放在独立 schema `sumly`（search_path 指定）；值为 URL，必须加引号，
# 否则 make source .env 时 `&` 会被 shell 解释。
# 首次使用前需在该实例执行一次：CREATE SCHEMA IF NOT EXISTS sumly;
DATABASE_URL="postgres://football_app:<password>@211.154.18.252:15432/registration_system_go?sslmode=disable&search_path=sumly"
JWT_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
APP_ENV=development
# 开发测试专用：开启后注册 POST /api/v1/app/auth/dev/login（任意 identifier 直接换取 JWT），
# 仅用于本地 H5 联调，生产环境必须保持关闭（缺省/非 true 即为关闭）。
DEV_LOGIN_ENABLED=false
# 集成测试使用共享实例上的独立测试库（与 registration_system_go 的测试库相同），
# 每个用例在其中创建随机 schema 并自动回收。
TEST_DATABASE_URL="postgres://football_app:<password>@211.154.18.252:15432/registration_go_test?sslmode=disable"
